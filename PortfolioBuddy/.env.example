# LLM Provider: "gemini" (default), "perplexity", or "litellm"
LLM_PROVIDER=gemini

# Gemini config (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Perplexity config (required if LLM_PROVIDER=perplexity)
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar

# LiteLLM config (required if LLM_PROVIDER=litellm)
LITELLM_API_KEY=your_litellm_api_key_here
LITELLM_API_BASE=https://your-litellm-proxy.example.com/v1
LITELLM_MODEL=gpt-4o

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Portfolio CSV Configuration
PORTFOLIO_CSV_PATH=portfolio.csv

# Optional: Enhanced news API
NEWS_API_KEY=your_news_api_key_here
